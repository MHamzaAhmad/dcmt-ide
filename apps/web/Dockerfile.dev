FROM texlive/texlive:latest

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    sqlite3 \
    supervisor \
    build-essential \
    pkg-config \
    libssl-dev \
    ca-certificates \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Rust
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y && \
    . ~/.cargo/env && \
    rustup default stable

# Add Rust to PATH
ENV PATH="/root/.cargo/bin:$PATH"

# Install wasm-pack for WASM compilation
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | bash

# Add WebAssembly target
RUN rustup target add wasm32-unknown-unknown

# Install Node.js development tools
RUN npm install -g live-server pm2

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY apps/web/ ./apps/web/
# Create web-only workspace (exclude desktop app for Docker build)
RUN sed '/apps\/desktop/d' Cargo.toml > Cargo.web.toml && mv Cargo.web.toml Cargo.toml

# Build backend services for development (excluding git functionality for compatibility)
RUN cargo build \
    --bin sse-handler \
    --bin model-manager \
    --bin latex-compiler

# Build webtransport-server without native git features 
RUN cargo build \
    --bin webtransport-server \
    --no-default-features

# Build WASM module for development
WORKDIR /app/apps/web
RUN wasm-pack build --target web --out-dir pkg --dev --scope latex-ide

# Setup directories for unified services
WORKDIR /app
RUN mkdir -p /app/data /app/logs /app/config /app/data/tex /app/workspace/sample

# Copy web assets to serve location
RUN mkdir -p /app/web \
    && cp -r /app/apps/web/pkg /app/web/ \
    && cp /app/apps/web/index.html /app/web/ \
    && cp /app/apps/web/style.css /app/web/ \
    && cp /app/apps/web/manifest.json /app/web/ \
    && mkdir -p /app/web/assets \
    && cp -r /app/crates/editor/assets/* /app/web/assets/

# Create SQLite database
RUN sqlite3 /app/data/latex_ide.db "CREATE TABLE IF NOT EXISTS documents (id INTEGER PRIMARY KEY, name TEXT, content TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);"

# Create supervisor configuration for all services
RUN mkdir -p /etc/supervisor/conf.d
COPY apps/web/supervisord.conf /etc/supervisor/conf.d/latex-ide.conf

# Copy and setup log formatter and entrypoint
COPY scripts/log-formatter.sh /app/log-formatter.sh
COPY scripts/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN chmod +x /app/log-formatter.sh /app/docker-entrypoint.sh


# Expose all service ports
EXPOSE 8080 3001 3002 3003 3004

# Start all services with custom entrypoint
ENTRYPOINT ["/app/docker-entrypoint.sh"]