# DCMT Editor Environment Configuration

# Domain Configuration (REQUIRED)
# The container will automatically obtain a Let's Encrypt certificate for this domain
# Example: DOMAIN=yourdomain.com
DOMAIN=

# Let's Encrypt Configuration (optional)
# Email for certificate expiration notifications
LETSENCRYPT_EMAIL=
# Set to true to use staging environment for testing (won't get valid certs)
LETSENCRYPT_STAGING=false

# SSL Certificate Paths (optional)
# Use these if you have existing Let's Encrypt or other certificates
# These paths should be inside the container or mounted volumes
# SSL_CERT_PATH=/app/ssl/fullchain.pem
# SSL_KEY_PATH=/app/ssl/privkey.pem

# Clerk Authentication Configuration (Web only)
# Get these from https://dashboard.clerk.com
VITE_CLERK_PUBLISHABLE_KEY=
# Full URL to redirect users for sign-in (e.g., https://yourdomain.com/sign-in)
VITE_CLERK_SIGN_IN_URL=
# Clerk secret key for backend API authentication (LiteLLM and Tavily)
CLERK_SECRET_KEY=

# API Configuration
VITE_API_BASE_URL=http://localhost:8080
VITE_TAVILY_PROXY_BASE_URL

# Backend Configuration
DCMT_HOST=0.0.0.0
DCMT_PORT=3001
DCMT_WORKSPACE_PATH=/app/workspace

# LiteLLM Configuration
LITELLM_BASE_URL=http://127.0.0.1:4000

# Tavily API Configuration
TAVILY_API_KEY=
TAVILY_BASE_URL=https://api.tavily.com

# API Keys for LiteLLM (add your provider keys here)
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GROQ_API_KEY=gsk_...
# TOGETHER_API_KEY=...
# AZURE_API_KEY=...
# GEMINI_API_KEY=...