FROM rust:1.89

# Install system dependencies for unified development environment
RUN apt-get update && apt-get install -y \
    curl \
    nodejs \
    npm \
    sqlite3 \
    texlive-latex-recommended \
    texlive-latex-extra \
    texlive-fonts-recommended \
    supervisor \
    && rm -rf /var/lib/apt/lists/*

# Install wasm-pack for WASM compilation
RUN curl https://rustwasm.github.io/wasm-pack/installer/init.sh -sSf | sh

# Add WebAssembly target
RUN rustup target add wasm32-unknown-unknown

# Install Node.js development tools
RUN npm install -g live-server pm2

WORKDIR /app

# Copy workspace files
COPY Cargo.toml Cargo.lock ./
COPY crates/ ./crates/
COPY apps/web/ ./apps/web/

# Build backend services for development
RUN cargo build \
    --bin webtransport-server \
    --bin sse-handler \
    --bin model-manager

# Build WASM module for development
WORKDIR /app/apps/web
RUN wasm-pack build --target web --out-dir pkg --dev --scope latex-ide

# Setup directories for unified services
WORKDIR /app
RUN mkdir -p /app/data /app/logs /app/config

# Copy web assets to serve location
RUN mkdir -p /app/web
RUN cp -r /app/apps/web/pkg /app/web/
RUN cp /app/apps/web/index.html /app/web/
RUN cp /app/apps/web/style.css /app/web/

# Create SQLite database
RUN sqlite3 /app/data/latex_ide.db "CREATE TABLE IF NOT EXISTS documents (id INTEGER PRIMARY KEY, name TEXT, content TEXT, created_at DATETIME DEFAULT CURRENT_TIMESTAMP);"

# Create supervisor configuration for all services
RUN mkdir -p /etc/supervisor/conf.d

# Copy service startup configuration
COPY apps/web/supervisord.conf /etc/supervisor/conf.d/latex-ide.conf

# Create startup script
RUN echo '#!/bin/bash\n\
echo "Starting LaTeX IDE unified development server..."\n\
echo "Frontend: http://localhost:8080"\n\
echo "WebTransport Server: localhost:3001"\n\
echo "SSE Handler: localhost:3002"\n\
echo "Model Manager: localhost:3003"\n\
echo "Database: SQLite at /app/data/latex_ide.db"\n\
exec supervisord -c /etc/supervisor/supervisord.conf -n\n\
' > /app/start-dev.sh && chmod +x /app/start-dev.sh

# Expose all service ports
EXPOSE 8080 3001 3002 3003

# Health check for the web frontend
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8080/ || exit 1

# Start all services with supervisor
CMD ["/app/start-dev.sh"]