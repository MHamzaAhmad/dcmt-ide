# DCMT Backend Configuration
# Copy this file to .env and modify as needed

# Workspace directory path (default: ./workspace)
DCMT_WORKSPACE_PATH=./workspace

# Server host (default: 127.0.0.1)
DCMT_HOST=127.0.0.1

# Server port (default: 3001)
DCMT_PORT=3001

# Logging configuration (standard Rust env_filter syntax)
RUST_LOG=dcmt_backend=debug,tower_http=debug

# Agent/LiteLLM Configuration
# LiteLLM API base URL (default: http://0.0.0.0:4000)
LITELLM_BASE_URL=http://0.0.0.0:4000

# Authentication Configuration
# Set to true to require Bearer token authentication (default: false)
REQUIRE_AUTH=false